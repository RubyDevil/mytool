#!/usr/bin/env bash

app_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib/ansi.sh
source "$app_dir/lib/ansi.sh"
# shellcheck source=lib/settings.sh
source "$app_dir/lib/settings.sh"
# shellcheck source=lib/menu.sh
source "$app_dir/lib/menu.sh"
# shellcheck source=lib/sidebar.sh
source "$app_dir/lib/sidebar.sh"
# shellcheck source=core/reverse_proxy.sh
source "$app_dir/core/reverse_proxy.sh"
# shellcheck source=core/vps_setup.sh
source "$app_dir/core/vps_setup.sh"
# shellcheck source=core/util_scripts.sh
source "$app_dir/core/util_scripts.sh"
# shellcheck source=core/self_update.sh
source "$app_dir/core/self_update.sh"
mytool_root_dir=$(cd -- "$app_dir/.." && pwd)
unset app_dir

# Initialization run by the freshly updated code after every update.
mytool_post_update_hooks=(post_update_install_launcher post_update_refresh_util_scripts)

wait_for_key() {
   printf '\n%sPress any key to continue...%s' "$DIM" "$RESET"
   IFS= read -rsn1
   printf '\n'
}

prompt_confirm() {
   local prompt="$1"
   local reply

   IFS= read -r -n1 -p "$prompt" reply
   printf '\n'
   [[ "$reply" =~ ^[Yy]$ ]]
}

print_success() {
   printf '%s%s%s\n' "$GREEN" "$1" "$RESET"
}

print_error() {
   printf '%s%s%s\n' "$RED" "$1" "$RESET" >&2
}

task_exit() {
   exit 0
}

task_vps_change_password() {
   clear
   passwd
   wait_for_key
}

task_vps_setup_existing_key() {
   local public_key

   clear
   IFS= read -r -p 'Paste the public SSH key: ' public_key
   if vps_setup_append_public_key "$public_key"; then
      print_success 'The public key is ready for SSH login.'
   else
      print_error 'Could not add the public key. Paste one complete SSH public key.'
   fi
   wait_for_key
}

task_vps_generate_key() {
   local key_type="$1"
   local key_path
   local public_key

   clear
   IFS= read -r -p 'Save private key at [~/.ssh/id_'"$key_type"']: ' key_path
   key_path=${key_path:-"$HOME/.ssh/id_$key_type"}
   if ! vps_setup_generate_key "$key_type" "$key_path"; then
      print_error 'SSH key generation failed.'
      wait_for_key
      return
   fi
   public_key=$(<"$key_path.pub")
   if ! vps_setup_append_public_key "$public_key"; then
      print_error 'The key was generated but its public key could not be configured.'
      wait_for_key
      return
   fi
   printf '\nPrivate key saved at: %s\n' "$key_path"
   print_success 'The public key is configured and ready for SSH login.'
   printf '\nSave this private key securely:\n\n'
   cat -- "$key_path"
   printf '\n'
   wait_for_key
}

task_vps_change_ssh_port() {
   local current_port
   local new_port

   clear
   current_port=$(vps_setup_ssh_port)
   printf 'Current SSH port: %s\n\n' "$current_port"
   IFS= read -r -p 'Enter new SSH port: ' new_port
   if ! vps_setup_validate_ssh_port "$new_port"; then
      print_error 'Invalid port. Enter a number between 1 and 65535.'
   elif vps_setup_update_sshd_option Port "$new_port"; then
      print_success "SSH now listens on port $new_port."
   else
      print_error 'SSH configuration was not changed.'
   fi
   wait_for_key
}

task_vps_disable_password_login() {
   local confirmation

   clear
   printf '%sWARNING: This can permanently lock you out of this server.%s\n' "$RED" "$RESET"
   printf 'Confirm that a working SSH public key is configured before continuing.\n'
   IFS= read -r -p 'Type DISABLE PASSWORD LOGIN to continue: ' confirmation
   if [[ "$confirmation" != 'DISABLE PASSWORD LOGIN' ]]; then
      print_error 'Operation canceled.'
   elif vps_setup_update_sshd_option PasswordAuthentication no; then
      print_success 'SSH password login has been disabled.'
   else
      print_error 'SSH password login was not changed.'
   fi
   wait_for_key
}

task_vps_print_ssh_config() {
   local handle
   local identity_file
   local current_user
   local ip_address
   local ssh_port

   clear
   IFS= read -r -p 'SSH config handle: ' handle
   if ! vps_setup_validate_ssh_handle "$handle"; then
      print_error 'Invalid handle. Use letters, digits, dots, underscores, and hyphens.'
      wait_for_key
      return
   fi
   IFS= read -r -p 'Identity file path (optional): ' identity_file
   current_user=$(vps_setup_current_user)
   ip_address=$(vps_setup_ip_address)
   ssh_port=$(vps_setup_ssh_port)
   printf '\nHost %s\n    User              %s\n    HostName          %s\n    Port              %s\n' "$handle" "$current_user" "$ip_address" "$ssh_port"
   if [[ -n "$identity_file" ]]; then
      printf '    IdentityFile      "%s"\n' "$identity_file"
   else
      printf '    Password          <your SSH password>\n'
   fi
   wait_for_key
}

task_vps_setup_tailscale() {
   local hostname
   local enable_ssh=0
   local tailscale_ip

   clear
   if ! vps_setup_tailscale_installed; then
      print_error 'Tailscale is not installed. Install it from Software Management first.'
      wait_for_key
      return
   fi
   IFS= read -r -p 'Tailscale machine name (optional): ' hostname
   if [[ -n "$hostname" ]] && ! vps_setup_validate_tailscale_hostname "$hostname"; then
      print_error 'Invalid name. Use letters, digits, and hyphens (up to 63 characters).'
      wait_for_key
      return
   fi
   prompt_confirm 'Enable Tailscale SSH? [y/N] ' && enable_ssh=1
   printf '\nOpen the login URL printed below to add this server to your tailnet.\n\n'
   if vps_setup_tailscale_up "$enable_ssh" "$hostname"; then
      tailscale_ip=$(vps_setup_tailscale_ip)
      print_success "Tailscale is connected${tailscale_ip:+ at $tailscale_ip}."
   else
      print_error 'Tailscale setup did not complete.'
   fi
   wait_for_key
}

task_vps_set_reinstall_mode() {
   vps_reinstall_selected=1
}

task_vps_update_packages() {
   printf '%sINSTALLING system packages%s\n\n' "$CYAN" "$RESET"
   vps_setup_update_packages
}

task_vps_install_software() {
   local label="$1"
   local software="$2"

   printf '%sINSTALLING %s%s\n\n' "$CYAN" "$label" "$RESET"
   vps_setup_install_software "$software" "${vps_reinstall_selected:-0}"
}

task_vps_software_start() {
   clear
}

task_vps_software_complete() {
   wait_for_key
}

util_scripts_status_label() {
   case "$(util_scripts_status "$1")" in
   installed) printf '%s(installed)%s' "$GREEN" "$RESET" ;;
   outdated) printf '%s(update available)%s' "$YELLOW" "$RESET" ;;
   removed) printf '%s(removed from repository)%s' "$RED" "$RESET" ;;
   *) printf '%s(not installed)%s' "$DIM" "$RESET" ;;
   esac
}

util_scripts_describe() {
   local name="$1"

   printf 'Status: %s\n' "$(util_scripts_status_label "$name")"
   printf 'Path:   %s\n\n' "$(util_scripts_target "$name")"
   util_scripts_doc "$name"
}

# Download the scripts repository the first time the category opens.
task_util_scripts_open() {
   if [[ ! -d "$(util_scripts_cache_dir)/.git" && -n "${settings[UTIL_SCRIPTS_REPO]-}" ]]; then
      clear
      printf '%sDownloading utility scripts from %s%s\n\n' "$DIM" "${settings[UTIL_SCRIPTS_REPO]}" "$RESET"
      if ! util_scripts_sync; then
         printf '\n'
         print_error 'Could not download the scripts repository.'
         wait_for_key
      fi
   fi
   build_menu_util_scripts
}

task_util_scripts_update() {
   clear
   printf '%sUPDATING utility scripts from %s%s\n\n' "$CYAN" "${settings[UTIL_SCRIPTS_REPO]:-the repository}" "$RESET"
   if ! util_scripts_sync; then
      printf '\n'
      print_error 'Could not pull the scripts repository; nothing was changed.'
   elif util_scripts_update_installed; then
      print_success 'Utility scripts are up to date.'
   else
      print_error 'Some utility scripts could not be updated; their previous versions were kept.'
   fi
   wait_for_key
}

task_util_scripts_show() {
   local name
   local -a names=()

   mapfile -t names < <(util_scripts_all)
   if ((${#names[@]} == 0)); then
      clear
      print_error 'No utility scripts are available. Check UTIL_SCRIPTS_REPO in the settings.'
      wait_for_key
      return
   fi
   sidebar_clear 'Scripts' util_scripts_describe
   for name in "${names[@]}"; do
      sidebar_add "$name"
   done
   sidebar_start
}

task_util_scripts_batch_start() {
   clear
}

task_util_scripts_install() {
   local name="$1"

   printf '%sINSTALLING %s%s\n\n' "$CYAN" "$name" "$RESET"
   if util_scripts_install "$name"; then
      print_success "$name is installed at $(util_scripts_target "$name")."
   else
      print_error "$name was not installed."
   fi
   printf '\n'
}

task_util_scripts_install_complete() {
   wait_for_key
   build_menu_util_scripts_install
}

task_util_scripts_uninstall() {
   local name="$1"

   printf '%sUNINSTALLING %s%s\n\n' "$CYAN" "$name" "$RESET"
   if util_scripts_uninstall "$name"; then
      print_success "$name was uninstalled."
   else
      print_error "$name could not be fully uninstalled."
   fi
   printf '\n'
}

task_util_scripts_uninstall_complete() {
   wait_for_key
   build_menu_util_scripts_uninstall
}

post_update_install_launcher() {
   printf 'Installing the mytool command at %s\n' "$(self_update_launcher)"
   if ! self_update_install_launcher "$mytool_root_dir"; then
      print_error 'Could not install the mytool command.'
      return 1
   fi
}

post_update_refresh_util_scripts() {
   printf 'Updating installed utility scripts\n'
   if ! util_scripts_refresh; then
      print_error 'Some utility scripts could not be updated.'
      return 1
   fi
}

task_post_update() {
   local hook
   local status=0

   clear
   printf '%sINITIALIZING mytool components%s\n\n' "$CYAN" "$RESET"
   for hook in "${mytool_post_update_hooks[@]}"; do
      "$hook" || status=1
   done
   printf '\n'
   if ((status == 0)); then
      print_success 'mytool is up to date. Run it from anywhere with: mytool'
   else
      print_error 'mytool was updated, but some components failed to initialize.'
   fi
   wait_for_key
}

task_update_mytool() {
   clear
   printf '%sUPDATING mytool from %s%s\n\n' "$CYAN" "$mytool_root_dir" "$RESET"
   if ! self_update_pull "$mytool_root_dir"; then
      printf '\n'
      print_error 'mytool was not updated.'
      wait_for_key
      return
   fi
   # Restart with the new code so its own initialization runs.
   exec bash -- "$mytool_root_dir/src/mytool" --post-update
}

settings_validate_value() {
   local key="$1"
   local value="$2"
   local normalized

   [[ "$value" != *$'\n'* && "$value" != *$'\r'* && "$value" != *$'\033'* ]] || return 1

   case "$key" in
   NGINX_CONFIG_DIR)
      [[ -n "$value" && "$value" == /* ]]
      ;;
   MENU_BORDER_TYPE)
      normalized=${value^^}
      [[ "$normalized" == LIGHT || "$normalized" == HEAVY ]]
      ;;
   MENU_BORDER_COLOR | MENU_POINTER_COLOR)
      normalized=${value^^}
      [[ -n "${ANSI[$normalized]+set}" ]]
      ;;
   MENU_POINTER_TYPE)
      [[ $(slen "$value") -eq 1 ]]
      ;;
   UTIL_SCRIPTS_REPO)
      [[ -z "$value" ]] || util_scripts_validate_repo "$value"
      ;;
   *)
      return 1
      ;;
   esac
}

settings_choice_values() {
   case "$1" in
   MENU_BORDER_TYPE)
      printf '%s\n' LIGHT HEAVY
      ;;
   MENU_BORDER_COLOR | MENU_POINTER_COLOR)
      printf '%s\n' BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE DEFAULT
      ;;
   *)
      return 1
      ;;
   esac
}

settings_sanitize() {
   local key

   for key in "${!default_settings[@]}"; do
      if ! settings_validate_value "$key" "${settings[$key]-}"; then
         printf 'Invalid value for %s; using its default.\n' "$key" >&2
         settings["$key"]="${default_settings[$key]}"
      fi
   done
}

settings_display_key_info() {
   local key="$1"

   printf 'Key: %s\n' "$key"
   printf 'Current value: %s\n' "${settings[$key]}"
   printf 'Default value: %s\n' "${default_settings[$key]}"
}

task_add_reverse_proxy() {
   local domain port

   clear
   printf '%sAdd a new reverse proxy configuration%s\n\n' "$DIM" "$RESET"
   IFS= read -r -p 'Enter domain: ' domain

   if ! reverse_proxy_validate_domain "$domain"; then
      print_error "Invalid domain: $domain"
      wait_for_key
      return
   fi
   if [[ -n "${domains_and_ports[$domain]+set}" ]]; then
      print_error 'Domain already exists.'
      wait_for_key
      return
   fi

   IFS= read -r -p 'Enter port: ' port
   if ! reverse_proxy_validate_port "$port"; then
      print_error "Invalid port: $port. Enter a number between 1 and 65535."
      wait_for_key
      return
   fi

   printf '\n%sSaving configuration and reloading Nginx...%s\n' "$DIM" "$RESET"
   if ! reverse_proxy_apply_config "$domain" "$port"; then
      print_error 'The configuration was not applied; the previous Nginx state was restored.'
      wait_for_key
      return
   fi

   build_menu_reverse_proxy
   printf '\n'
   print_success 'Reverse proxy configuration added.'
   wait_for_key
}

task_modify_reverse_proxy() {
   local domain="$1"
   local port="${domains_and_ports[$domain]}"
   local new_port

   clear
   printf '%sModify reverse proxy configuration for %s%s\n\n' "$DIM" "$domain" "$RESET"
   IFS= read -r -p "Enter port [$port]: " new_port
   new_port=${new_port:-$port}

   if ! reverse_proxy_validate_port "$new_port"; then
      print_error "Invalid port: $new_port. Enter a number between 1 and 65535."
      wait_for_key
      return
   fi
   if [[ "$new_port" == "$port" ]]; then
      print_error 'The new port is the same as the current port.'
      wait_for_key
      return
   fi

   printf '\n%sSaving configuration and reloading Nginx...%s\n' "$DIM" "$RESET"
   if ! reverse_proxy_apply_config "$domain" "$new_port"; then
      print_error 'The configuration was not applied; the previous Nginx state was restored.'
      wait_for_key
      return
   fi

   build_menu_reverse_proxy "$domain"
   printf '\n'
   print_success 'Reverse proxy configuration updated.'
   wait_for_key
}

task_delete_reverse_proxy() {
   local domain="$1"

   clear
   printf '%sDelete reverse proxy configuration for %s%s\n\n' "$DIM" "$domain" "$RESET"
   if ! prompt_confirm 'Are you sure you want to delete this configuration? [y/N] '; then
      print_error 'Operation canceled.'
      printf '%s' "$BEEP"
      wait_for_key
      return
   fi

   printf '\n%sDeleting configuration and reloading Nginx...%s\n' "$DIM" "$RESET"
   if ! reverse_proxy_remove_config "$domain"; then
      print_error 'The configuration was not deleted; the previous Nginx state was restored.'
      wait_for_key
      return
   fi

   build_menu_reverse_proxy
   printf '\n'
   print_success 'Reverse proxy configuration deleted.'
   wait_for_key
}

task_inspect_settings_key() {
   clear
   settings_display_key_info "$1"
   wait_for_key
}

task_apply_settings_value() {
   local key="$1"
   local new_value="$2"
   local old_value="${settings[$key]}"

   if ! settings_validate_value "$key" "$new_value"; then
      print_error "Invalid value for $key."
      wait_for_key
      return
   fi

   clear
   printf '%s' "$DIM"
   settings_display_key_info "$key"
   printf '%s\n' "$RESET"
   printf '\nCurrent value: %s\nNew value: %s\n\n' "$old_value" "$new_value"
   if ! prompt_confirm 'Are you sure you want to update the setting? [y/N] '; then
      print_error 'Operation canceled.'
      printf '%s' "$BEEP"
      wait_for_key
      return
   fi

   settings["$key"]="$new_value"
   if ! settings_save_to_file; then
      settings["$key"]="$old_value"
      print_error 'Could not save settings; the value was not changed.'
      wait_for_key
      return
   fi

   build_menu_settings "$key"
   print_success 'Setting updated.'
   wait_for_key
}

task_modify_settings_key() {
   local key="$1"
   local new_value

   clear
   printf '%s' "$DIM"
   settings_display_key_info "$key"
   printf '%s\n\n' "$RESET"
   IFS= read -r -p 'Enter new value: ' new_value

   task_apply_settings_value "$key" "$new_value"
}

task_restore_default_settings_key() {
   local key="$1"
   local old_value="${settings[$key]}"

   clear
   printf '%s' "$DIM"
   settings_display_key_info "$key"
   printf '%s\n\n' "$RESET"

   if ! prompt_confirm 'Are you sure you want to restore the default value? [y/N] '; then
      print_error 'Operation canceled.'
      printf '%s' "$BEEP"
      wait_for_key
      return
   fi

   settings["$key"]="${default_settings[$key]}"
   if ! settings_save_to_file; then
      settings["$key"]="$old_value"
      print_error 'Could not save settings; the value was not changed.'
      wait_for_key
      return
   fi

   build_menu_settings "$key"
   print_success 'Default value restored.'
   wait_for_key
}

build_menu_main() {
   menu_clear 'Main Menu'
   menu_set_exit task_exit
   menu_add 'Tools' build_menu_tools
   menu_add 'Utility Scripts' task_util_scripts_open
   menu_add "${CYAN}Update MyTool${RESET}" task_update_mytool
   menu_add "${DIM}Edit settings${RESET}" build_menu_settings
}

build_menu_util_scripts() {
   menu_clear 'Utility Scripts'
   menu_set_back build_menu_main
   menu_add 'Show Scripts' task_util_scripts_show
   menu_add "${GREEN}Install Scripts${RESET}" build_menu_util_scripts_install
   menu_add "${RED}Uninstall Scripts${RESET}" build_menu_util_scripts_uninstall
   menu_add "${CYAN}Update Scripts${RESET}" task_util_scripts_update
}

build_menu_util_scripts_install() {
   local name

   menu_clear_multi 'Install Scripts'
   menu_set_selected_start_callback task_util_scripts_batch_start
   menu_set_selected_complete_callback task_util_scripts_install_complete
   menu_set_back build_menu_util_scripts
   while IFS= read -r name; do
      menu_add "$name $(util_scripts_status_label "$name")" task_util_scripts_install "$name"
   done < <(util_scripts_available)
   if ((${#menu_labels[@]} == 0)); then
      menu_add_action "${DIM}No scripts found; check UTIL_SCRIPTS_REPO in the settings${RESET}" build_menu_util_scripts_install
   fi
}

build_menu_util_scripts_uninstall() {
   local name

   menu_clear_multi 'Uninstall Scripts'
   menu_set_selected_start_callback task_util_scripts_batch_start
   menu_set_selected_complete_callback task_util_scripts_uninstall_complete
   menu_set_back build_menu_util_scripts
   while IFS= read -r name; do
      menu_add "$name $(util_scripts_status_label "$name")" task_util_scripts_uninstall "$name"
   done < <(util_scripts_installed)
   if ((${#menu_labels[@]} == 0)); then
      menu_add_action "${DIM}No scripts are installed${RESET}" build_menu_util_scripts_uninstall
   fi
}

